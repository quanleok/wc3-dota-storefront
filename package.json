{
  "name": "wc3dotashop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "assets:import-shared": "node scripts/import-shared-wc3-textures.mjs",
    "assets:manifest": "node scripts/generate-wc3-asset-manifest.mjs",
    "assets:thumbnails": "node scripts/generate-inventory-thumbnails.mjs",
    "assets:videos": "node scripts/generate-preview-videos.mjs",
    "assets:audio:suno": "node scripts/generate-evolink-suno-audio.mjs",
    "assets:audio:final": "node scripts/generate-final-polish-audio.mjs",
    "assets:audio:polish": "node scripts/polish-audio-assets.mjs",
    "deploy:assets": "node scripts/prepare-vercel-static-assets.mjs",
    "deploy:prod": "vercel build --prod && npm run deploy:assets && vercel deploy --prebuilt --prod --yes"
  },
  "dependencies": {
    "mdx-m3-viewer": "^5.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stripe": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
